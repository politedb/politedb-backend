{
  "name": "politedb-be",
  "version": "1.0.0",
  "description": "Express backend for PoliteDB",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --include 'src/**/*.ts' src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:diff": "tsx scripts/db-diff.ts"
  },
  "keywords": [
    "express",
    "license",
    "typescript",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mikro-orm/core": "6.6.13",
    "@mikro-orm/migrations": "6.6.13",
    "@mikro-orm/postgresql": "6.6.13",
    "@polar-sh/sdk": "^0.47.0",
    "@sentry/node": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.9",
    "pg": "^8.20.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@mikro-orm/sqlite": "7.2.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
