PORT=4000
# Which proxies may set X-Forwarded-For. Leave empty for local development (defaults to
# "loopback"). On Render, set the hop count measured with GET /api/v1/admin/debug/client-ip;
# rate limiting stays off there until it is set. Never "true" on a public port.
TRUST_PROXY=
# Optional error reporting. Request bodies, headers and cookies are never sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Required. The server refuses to start without it or with "change-me".
# Generate one with: openssl rand -hex 32
LICENSE_API_KEY=
DATABASE_URL=postgresql://politedb:politedb@localhost:5432/politedb

# Polar
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCT_IDS=
POLAR_SUCCESS_URL=http://localhost:3000/billing/success
POLAR_RETURN_URL=http://localhost:3000/billing
# Extra browser origins (comma-separated) allowed for CORS and for client-supplied checkout
# success/return URLs. The origins of POLAR_SUCCESS_URL and POLAR_RETURN_URL are always allowed.
CHECKOUT_ALLOWED_ORIGINS=

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PoliteDB <licenses@localhost>
