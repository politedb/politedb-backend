PORT=4000
LICENSE_API_KEY=change-me
DATABASE_PATH=./data/license-key.db
DATABASE_URL=postgresql://politedb:politedb@localhost:5432/politedb
DEFAULT_PRODUCT=politedb

# Polar
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCT_IDS=
POLAR_SUCCESS_URL=http://localhost:3000/billing/success
POLAR_RETURN_URL=http://localhost:3000/billing

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PoliteDB <licenses@localhost>

# AI Gateway
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODELS=gpt-4.1-nano,gpt-4.1-mini,gpt-4.1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODELS=deepseek-v4-pro

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
AI_ANTHROPIC_MODELS=Sonnet 4.6=claude-sonnet-4-6,Opus 4.7=claude-opus-4-7,Opus 4.8=claude-opus-4-8

GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_GOOGLE_MODELS=Gemini 3.1 Pro=gemini-3.1-pro

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
AI_XAI_MODELS=Grok 4.3=grok-4.3,Grok Build 0.1=grok-build-0.1

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
AI_MOONSHOT_MODELS=Kimi K2.6=kimi-k2.6

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_ZHIPU_MODELS=GLM 5.2=glm-5.2

# AI Defaults
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_FREE_MODEL=GPT-5.2
AI_DEFAULT_ULTIMATE_MODEL=GPT-5.5
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_ENABLE_CACHE=true
AI_ENABLE_SEMANTIC_CACHE=false
AI_FREE_DAILY_REQUESTS=20
AI_ULTIMATE_DAILY_REQUESTS=2000
