PORT=4000
# Required. The server refuses to start without it or with "change-me".
# Generate one with: openssl rand -hex 32
LICENSE_API_KEY=
DATABASE_PATH=./data/license-key.db
DATABASE_URL=postgresql://politedb:politedb@localhost:5432/politedb
DEFAULT_PRODUCT=politedb

# Polar
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCT_IDS=
POLAR_SUCCESS_URL=http://localhost:3000/billing/success
POLAR_RETURN_URL=http://localhost:3000/billing
# Extra origins allowed for client-supplied checkout success/return URLs (comma-separated).
# The origins of POLAR_SUCCESS_URL and POLAR_RETURN_URL are always allowed.
CHECKOUT_ALLOWED_ORIGINS=

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PoliteDB <licenses@localhost>
